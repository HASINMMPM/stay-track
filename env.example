# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (when you add a database)
# DATABASE_URL=postgresql://username:password@localhost:5432/staytrack
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=staytrack
# DB_USER=username
# DB_PASSWORD=password

# JWT Configuration (when you add authentication)
# JWT_SECRET=your-super-secret-jwt-key
# JWT_EXPIRES_IN=7d

# CORS Configuration
# CORS_ORIGIN=http://localhost:3000

# Logging
# LOG_LEVEL=info
